proc filter_values(filter, values){
    let new_values = list();

    for(let i = 0; i < values.len(); i += 1){
        let value = values[i];

        if(filter(i, value)){
            new_values.insert(value);
        }
    }

    ret new_values;
}

proc quick_sort(comparator, values){
    let len = values.len();

    if(len <= 2){
        if(len == 2){
            let a = values[0];
            let b = values[1];

            if(a > b){
                values[1] = a;
                values[0] = b;
            }
        }

        ret values;
    }

    let pivot_idx = 0;
    let pivot = values[pivot_idx];
    let less = filter_values(anon(idx, value){
        if(idx == pivot_idx){
            ret false;
        }

        ret comparator(value, pivot) <= 0;
    }, values);
    let greater = filter_values(anon(idx, value){
        if(idx == pivot_idx){
            ret false;
        }

        ret comparator(value, pivot) == 1;
    }, values);

    ret quick_sort(comparator, less) .. pivot .. quick_sort(comparator, greater);
}

let a_values = list(0,1,2,3,4);
let b_values = list(5,6,7,8,9);
let c_values = b_values .. a_values;
let sorted = quick_sort(anon(a, b){
    if(a < b){
        ret -1;
    }elif(a > b){
        ret 1;
    }else{
        ret 0;
    }
}, c_values);

println(to_str(b_values) .. " + " .. to_str(a_values) .. " = " .. to_str(c_values));
println("sorted: " .. to_str(sorted));